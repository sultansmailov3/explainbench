{
    // Terminal → Run Task…  (mirrors the Makefile targets, which need `make` and do not run on Windows)
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    "tasks": [
        {
            "label": "Unit tests",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Validate suite (Table 1)",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "explainbench.validate", "--generated"],
            "problemMatcher": []
        },
        {
            "label": "Mock 1/3: explanations",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "explainbench.make_explanations", "--mock", "--out", "outputs/mock/explanations"],
            "problemMatcher": []
        },
        {
            "label": "Mock 2/3: experiment",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "explainbench.run_experiment", "--mock", "--explanations", "outputs/mock/explanations", "--seeds", "2"],
            "problemMatcher": []
        },
        {
            "label": "Mock 3/3: analyze",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "explainbench.analyze", "--run", "outputs/mock", "--allow-mock"],
            "problemMatcher": []
        },
        {
            // Plumbing check only, NEVER research data (output is git-ignored).
            "label": "Mock pipeline (all steps)",
            "dependsOrder": "sequence",
            "dependsOn": ["Mock 1/3: explanations", "Mock 2/3: experiment", "Mock 3/3: analyze"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
