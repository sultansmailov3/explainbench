{
  "id": "t07_count_vowels",
  "title": "Count vowels",
  "entry": "count_vowels",
  "description": "Return how many characters of the string s are vowels (a, e, i, o, u), ignoring case.",
  "demo_count": 4,
  "tests": [
    {
      "args": [
        "hello"
      ],
      "expected": 2
    },
    {
      "args": [
        ""
      ],
      "expected": 0
    },
    {
      "args": [
        "xyz"
      ],
      "expected": 0
    },
    {
      "args": [
        "AEIOU"
      ],
      "expected": 5
    },
    {
      "args": [
        "a"
      ],
      "expected": 1
    },
    {
      "args": [
        "Education"
      ],
      "expected": 5
    },
    {
      "args": [
        "rhythm"
      ],
      "expected": 0
    }
  ],
  "mutants": [
    {
      "id": "m1",
      "file": "mutants/m1.py",
      "category": "loop_condition"
    },
    {
      "id": "m2",
      "file": "mutants/m2.py",
      "category": "off_by_one"
    }
  ]
}
