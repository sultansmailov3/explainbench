{
  "id": "t15_unique_items",
  "title": "Unique items in order",
  "entry": "unique_items",
  "description": "Return a new list containing each distinct element of xs once, keeping the order of FIRST appearance.",
  "demo_count": 4,
  "tests": [
    {
      "args": [
        [
          1,
          2,
          1
        ]
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "args": [
        []
      ],
      "expected": []
    },
    {
      "args": [
        [
          3
        ]
      ],
      "expected": [
        3
      ]
    },
    {
      "args": [
        [
          1,
          1,
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "args": [
        [
          2,
          1,
          2,
          1
        ]
      ],
      "expected": [
        2,
        1
      ]
    },
    {
      "args": [
        [
          "a",
          "b",
          "a"
        ]
      ],
      "expected": [
        "a",
        "b"
      ]
    },
    {
      "args": [
        [
          4,
          5,
          6
        ]
      ],
      "expected": [
        4,
        5,
        6
      ]
    }
  ],
