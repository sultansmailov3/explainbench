{
  "id": "t02_first_zero",
  "title": "Index of first zero",
  "entry": "first_zero_index",
  "description": "Return the index of the first element equal to 0 in the list xs, or -1 if the list contains no zero.",
  "demo_count": 4,
  "tests": [
    {
      "args": [
        [
          2,
          4,
          0,
          9
        ]
      ],
      "expected": 2
    },
    {
      "args": [
        [
          0,
          1
        ]
      ],
      "expected": 0
    },
    {
      "args": [
        [
          5,
          6,
          7
        ]
      ],
      "expected": -1
    },
    {
      "args": [
        []
      ],
      "expected": -1
    },
    {
      "args": [
        [
          1,
          0
        ]
      ],
      "expected": 1
    },
    {
      "args": [
        [
          3,
          0,
          0
        ]
      ],
      "expected": 1
    },
    {
      "args": [
        [
          7,
          8,
          9,
          0
        ]
      ],
      "expected": 3
    }
  ],
  "mutants": [
    {
      "id": "m1",
      "file": "mutants/m1.py",
      "category": "loop_condition"
    },
    {
      "id": "m2",
      "file": "mutants/m2.py",
      "category": "loop_condition"
    }
  ]
}
