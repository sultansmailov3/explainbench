{
  "id": "t20_running_total",
  "title": "Running totals",
  "entry": "running_total",
  "description": "Return a list whose i-th element is the sum of xs[0] .. xs[i]. For example [1, 2, 3] gives [1, 3, 6]; the empty list gives [].",
  "demo_count": 4,
  "tests": [
    {
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        3,
        6
      ]
    },
    {
      "args": [
        []
      ],
      "expected": []
    },
    {
      "args": [
        [
          5
        ]
      ],
      "expected": [
        5
      ]
    },
    {
      "args": [
        [
          2,
          2
        ]
      ],
      "expected": [
        2,
        4
      ]
    },
    {
      "args": [
        [
          1,
          1,
          1,
          1
        ]
      ],
      "expected": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "args": [
        [
          3,
          -1,
          2
        ]
      ],
      "expected": [
        3,
        2,
        4
      ]
    },
    {
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": [
        0,
        0
      ]
    }
  ],
  "mutants": [
    {
      "id": "m1",
      "file": "mutants/m1.py",
      "category": "off_by_one"
    },
    {
      "id": "m2",
      "file": "mutants/m2.py",
      "category": "data_structure_update"
    }
  ]
}
