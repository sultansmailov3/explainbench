{
  "id": "t06_max_of_list",
  "title": "Maximum of a list",
  "entry": "max_of_list",
  "description": "Return the largest element of the non-empty list xs without using the built-in max().",
  "demo_count": 4,
  "tests": [
    {
      "args": [
        [
          3,
          1,
          2
        ]
      ],
      "expected": 3
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1
    },
    {
      "args": [
        [
          5,
          9,
          2
        ]
      ],
      "expected": 9
    },
    {
      "args": [
        [
          -3,
          -1,
          -7
        ]
      ],
      "expected": -1
    },
    {
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 4
    },
    {
      "args": [
        [
          4,
          3,
          2,
          1
        ]
      ],
      "expected": 4
    },
    {
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": 0
    }
  ],
  "mutants": [
    {
      "id": "m1",
      "file": "mutants/m1.py",
      "category": "boundary_operator"
    },
    {
      "id": "m2",
      "file": "mutants/m2.py",
      "category": "loop_condition"
    }
  ]
}
