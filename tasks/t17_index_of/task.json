{
  "id": "t17_index_of",
  "title": "Linear search",
  "entry": "index_of",
  "description": "Return the index of the FIRST occurrence of target in the list xs, or -1 if target does not occur.",
  "demo_count": 4,
  "tests": [
    {
      "args": [
        [
          4,
          5,
          6
        ],
        5
      ],
      "expected": 1
    },
    {
      "args": [
        [
          4,
          5,
          6
        ],
        9
      ],
      "expected": -1
    },
    {
      "args": [
        [],
        1
      ],
      "expected": -1
    },
    {
      "args": [
        [
          7
        ],
        7
      ],
      "expected": 0
    },
    {
      "args": [
        [
          1,
          2,
          3
        ],
        3
      ],
      "expected": 2
    },
    {
      "args": [
        [
          2,
          2
        ],
        2
      ],
      "expected": 0
    },
    {
      "args": [
        [
          9,
          8
        ],
        8
      ],
      "expected": 1
    }
  ],
  "mutants": [
    {
      "id": "m1",
      "file": "mutants/m1.py",
      "category": "loop_condition"
    },
    {
      "id": "m2",
      "file": "mutants/m2.py",
      "category": "off_by_one"
    }
  ]
}
